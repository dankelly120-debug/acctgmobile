---
import ChapterSection from '../components/ChapterSection.astro';
interface Course { code: string; name: string; description: string; chapters: readonly { number: string; title: string; items: readonly { title: string; url: string; type: 'video'|'file'|'tool'; label?: string }[] }[]; }
const { course } = Astro.props as { course: Course };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={course.description} />
  <title>{course.name} | Accounting Learning Hub</title>
  <style is:global>
    :root{--navy:#12375b;--gold:#f4b942;--ink:#17202a;--muted:#5f6b76;--paper:#f5f7fa;--line:#dfe5eb}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper);line-height:1.5}header{background:var(--navy);color:#fff}nav{max-width:1120px;margin:auto;padding:16px 22px;display:flex;justify-content:space-between;gap:20px;align-items:center}nav a{color:#fff;text-decoration:none;font-weight:700}.navlinks{display:flex;flex-wrap:wrap;gap:18px}.hero{max-width:1120px;margin:auto;padding:54px 22px 46px}.eyebrow{color:var(--gold);font-weight:800;text-transform:uppercase;letter-spacing:.08em}.hero h1{font-size:clamp(2.2rem,6vw,4rem);line-height:1.05;margin:8px 0 12px}.hero p{max-width:760px;font-size:1.1rem;color:#e5edf5}main{max-width:1120px;margin:auto;padding:28px 22px 60px}.jump{display:flex;flex-wrap:wrap;gap:9px;margin:0 0 28px}.jump a{background:#fff;color:var(--navy);border:1px solid var(--line);border-radius:999px;padding:8px 12px;text-decoration:none;font-weight:700}.jump a:hover{background:#eef4f9}.contact{margin:2rem 0 0;background:#fff;border:1px solid var(--line);border-radius:20px;padding:clamp(1.2rem,3vw,1.8rem);box-shadow:0 6px 18px rgba(18,55,91,.06)}.contact h2{margin:0 0 .35rem;color:var(--navy)}.contact-intro{margin:0 0 1rem;color:var(--muted)}.contact-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.contact-card{border:1px solid var(--line);border-radius:14px;padding:1rem;background:#fbfcfe}.contact-card h3{margin:0 0 .4rem;font-size:1rem;color:var(--navy)}.contact-card p{margin:.25rem 0;color:var(--muted);font-size:.92rem}.contact-card a{color:var(--navy);font-weight:750}.directions{margin-top:.8rem;padding-top:.8rem;border-top:1px dashed var(--line)}footer{background:#0c2944;color:#dbe7f2;padding:28px 22px;text-align:center}@media(max-width:760px){nav{align-items:flex-start;flex-direction:column}.contact-grid{grid-template-columns:1fr}}
  </style>
</head>
<body id="top">
<header>
  <nav>
    <a href="/">Accounting Learning Hub</a>
    <div class="navlinks"><a href="/financial-accounting">Financial</a><a href="/managerial-accounting">Managerial</a><a href="/bookkeeping">Bookkeeping</a><a href="#contact">Contact</a></div>
  </nav>
  <div class="hero"><div class="eyebrow">{course.code}</div><h1>{course.name}</h1><p>{course.description}</p></div>
</header>
<main>
  <div class="jump">{course.chapters.map((chapter) => <a href={`#chapter-${chapter.number.replace(/[^a-zA-Z0-9]+/g, '-')}`}>Chapter {chapter.number}</a>)}</div>
  {course.chapters.map((chapter) => <ChapterSection {...chapter} />)}

  <section class="contact" id="contact">
    <h2>Contact Dan Kelly</h2>
    <p class="contact-intro">Questions about the course or a worked problem? Reach out by email, visit the office, or join the personal Zoom room.</p>
    <div class="contact-grid">
      <div class="contact-card">
        <h3>✉ Email</h3>
        <p><a href="mailto:daniel.kelly@icc.edu">daniel.kelly@icc.edu</a></p>
      </div>
      <div class="contact-card">
        <h3>📍 Office</h3>
        <p><strong>Room 333E</strong></p>
        <p>ICC East Peoria Campus</p>
      </div>
      <div class="contact-card">
        <h3>💻 Zoom</h3>
        <p><a href="https://us02web.zoom.us/my/dkellyicc" target="_blank" rel="noopener noreferrer">Open Dan Kelly's Zoom room ↗</a></p>
      </div>
    </div>
    <div class="directions">
      <h3>Directions to My Office on the East Peoria Campus</h3>
      <p>Walk into the double doors to the left of the building closest to you when you are in the visitor lot (around the corner and labeled door #9). Head to the open staircase—or take the elevator—and go up one floor to the café. Go past the art gallery into the academic hallway and turn right. About five doors later, the hallway takes a hard turn to the left; Room 333E is immediately on the left.</p>
    </div>
  </section>
</main>
<footer>Dan Kelly · Accounting Learning Hub</footer>
<script is:inline>
  document.querySelectorAll('.progress-check').forEach((box) => {
    const key = `acctg-progress:${location.pathname}:${box.dataset.progressId}`;
    box.checked = localStorage.getItem(key) === '1';
    box.addEventListener('change', () => localStorage.setItem(key, box.checked ? '1' : '0'));
  });
</script>
</body>
</html>
