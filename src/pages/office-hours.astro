---
const currentYear = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Fall 2026 office hours for Professor Dan Kelly." />
  <title>Office Hours | Dan Kelly Accounting</title>
  <style>
    :root{--navy:#112f4e;--navy-dark:#0a2036;--gold:#f0b323;--background:#f4f7fa;--text:#202a35;--muted:#5f6b78;--white:#fff;--border:#dce4eb;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--background);color:var(--text);line-height:1.6}.site-header{background:var(--navy-dark);color:var(--white);border-bottom:4px solid var(--gold)}.nav-container{width:min(1180px,calc(100% - 40px));min-height:72px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:30px}.brand,.nav-links a{color:var(--white);text-decoration:none;font-weight:800}.nav-links{display:flex;flex-wrap:wrap;gap:24px}.nav-links a{font-size:.95rem}.nav-links a:hover{color:var(--gold)}main{width:min(900px,calc(100% - 40px));margin:0 auto;padding:72px 0 90px}.eyebrow{margin:0 0 12px;color:#936800;font-size:.85rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}h1{margin:0;color:var(--navy-dark);font-size:clamp(2.5rem,7vw,4.6rem);line-height:1;letter-spacing:-.045em}.intro{margin:20px 0 36px;color:var(--muted);font-size:1.1rem}.card{background:var(--white);border:1px solid var(--border);border-radius:16px;padding:clamp(26px,5vw,44px);box-shadow:0 12px 35px rgba(17,47,78,.08)}.card h2{margin:0 0 18px;color:var(--navy-dark);font-size:1.65rem}.schedule{font-size:1.2rem}.schedule strong{color:var(--navy)}.note{margin-top:26px;padding-top:22px;border-top:1px solid var(--border);color:var(--muted)}.contact-link{color:var(--navy);font-weight:800}.zoom-button{display:inline-block;margin-top:18px;padding:12px 20px;border-radius:10px;background:var(--navy);color:var(--white);font-weight:800;text-decoration:none}.zoom-button:hover{background:var(--navy-dark)}.directions{margin-top:26px}.directions h2{margin-bottom:12px}.site-footer{background:var(--navy-dark);color:#dbe7f2;padding:26px 20px;text-align:center}@media(max-width:760px){.nav-container{align-items:flex-start;flex-direction:column;padding:18px 0}.nav-links{gap:12px 18px}}
  </style>
</head>
<body>
<header class="site-header">
  <nav class="nav-container" aria-label="Main navigation">
    <a class="brand" href="/">DAN KELLY | ACCOUNTING</a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/financial-accounting">Financial Accounting</a>
      <a href="/managerial-accounting">Managerial Accounting</a>
      <a href="/bookkeeping">Bookkeeping</a>
      <a href="/#contact">Contact</a>
    </div>
  </nav>
</header>
<main>
  <p class="eyebrow">Student Support</p>
  <h1>Office Hours</h1>
  <p class="intro">Current scheduled availability for the Fall 2026 semester.</p>
  <section class="card">
    <h2>Fall 2026 Office Hours</h2>
    <p class="schedule"><strong>Monday and Wednesday</strong><br />12:00 p.m.–12:50 p.m.</p>
    <p class="note">Additional meetings are available by appointment in person or through Zoom. Email <a class="contact-link" href="mailto:daniel.kelly@icc.edu">daniel.kelly@icc.edu</a> to arrange a time.</p>
    <a class="zoom-button" href="https://us02web.zoom.us/my/dkellyicc" target="_blank" rel="noopener noreferrer">Join My Zoom Room ↗</a>
  </section>
  <section class="card directions">
    <h2>Directions to My Office on the East Peoria Campus</h2>
    <p>Walk into the double doors to the left of the building closest to you when you are in the visitor lot (around the corner and labeled door #9). Head to the open staircase—or take the elevator—and go up one floor to the café. Go past the art gallery into the academic hallway and turn right. About five doors later, the hallway takes a hard turn to the left; Room 333E is immediately on the left.</p>
  </section>
</main>
<footer class="site-footer">© {currentYear} Dan Kelly · Accounting Learning Hub</footer>
</body>
</html>
