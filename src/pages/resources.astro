---
const resources = [
  {
    title: 'Financial Accounting',
    code: 'ACCTG 120',
    href: '/financial-accounting',
    description: 'Chapter videos, worked problems, problem-data PDFs, solutions, and accounting tools.'
  },
  {
    title: 'Managerial Accounting',
    code: 'ACCTG 121',
    href: '/managerial-accounting',
    description: 'Chapter videos, practice problems, solutions, and supporting managerial accounting resources.'
  },
  {
    title: 'Bookkeeping',
    code: 'ACCTG 105',
    href: '/bookkeeping',
    description: 'Bookkeeping lessons, walkthroughs, and course resources organized by topic.'
  }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Accounting course resources from Professor Dan Kelly." />
  <title>Resources | Professor Kelly Accounting</title>
  <style>
    :root{--navy:#12375b;--gold:#f4b942;--ink:#17202a;--muted:#5f6b76;--paper:#f5f7fa;--line:#dfe5eb;--white:#fff}*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper);line-height:1.55}header{background:var(--navy);color:#fff;border-bottom:4px solid var(--gold)}nav{max-width:1120px;margin:auto;padding:16px 22px;display:flex;justify-content:space-between;gap:20px;align-items:center}nav a{color:#fff;text-decoration:none;font-weight:700}.links{display:flex;flex-wrap:wrap;gap:18px}.hero{max-width:1120px;margin:auto;padding:58px 22px}.eyebrow{color:var(--gold);font-weight:800;text-transform:uppercase;letter-spacing:.08em}.hero h1{font-size:clamp(2.4rem,6vw,4rem);line-height:1.05;margin:8px 0 12px}.hero p{max-width:760px;color:#e5edf5;font-size:1.08rem}main{max-width:1120px;margin:auto;padding:42px 22px 70px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:28px;box-shadow:0 8px 24px rgba(18,55,91,.07)}.code{color:#1f6095;font-size:.85rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.card h2{color:var(--navy);margin:9px 0 10px}.card p{color:var(--muted);min-height:95px}.button{display:inline-block;background:var(--navy);color:#fff;text-decoration:none;font-weight:800;padding:12px 17px;border-radius:8px}.note{margin-top:30px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px;color:var(--muted)}footer{background:#0c2944;color:#dbe7f2;text-align:center;padding:28px 22px}@media(max-width:800px){nav{align-items:flex-start;flex-direction:column}.grid{grid-template-columns:1fr}.card p{min-height:auto}}
  </style>
</head>
<body>
<header>
  <nav>
    <a href="/">Accounting Learning Hub</a>
    <div class="links">
      <a href="/financial-accounting">Financial</a>
      <a href="/managerial-accounting">Managerial</a>
      <a href="/bookkeeping">Bookkeeping</a>
      <a href="/office-hours">Office Hours</a>
      <a href="/#contact">Contact</a>
    </div>
  </nav>
  <div class="hero">
    <div class="eyebrow">Student Resources</div>
    <h1>Course Resources</h1>
    <p>Your videos, practice problems, solutions, and downloadable materials are organized inside each course page so the files stay matched with the lesson they support.</p>
  </div>
</header>
<main>
  <div class="grid">
    {resources.map((resource) => (
      <article class="card">
        <div class="code">{resource.code}</div>
        <h2>{resource.title}</h2>
        <p>{resource.description}</p>
        <a class="button" href={resource.href}>Open Course Resources →</a>
      </article>
    ))}
  </div>
  <div class="note">
    <strong>Looking for a specific PDF?</strong> Open your course above and go to the appropriate chapter. Problem files, solutions, and walkthrough videos are grouped together there.
  </div>
</main>
<footer>Dan Kelly · Accounting Learning Hub</footer>
</body>
</html>
