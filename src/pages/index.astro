---
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="Accounting videos, course resources, and student support from Professor Dan Kelly."
    />

    <title>Dan Kelly | Accounting Learning Hub</title>

    <style>
      :root {
        --navy: #112f4e;
        --navy-dark: #0a2036;
        --blue: #1f6095;
        --gold: #f0b323;
        --background: #f4f7fa;
        --text: #202a35;
        --muted: #5f6b78;
        --white: #ffffff;
        --border: #dce4eb;

        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        line-height: 1.6;
      }

      a {
        color: inherit;
      }

      .site-header {
        background: var(--navy-dark);
        color: var(--white);
        border-bottom: 4px solid var(--gold);
      }

      .nav-container {
        width: min(1180px, calc(100% - 40px));
        min-height: 72px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
      }

      .brand {
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: 0.02em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .nav-links a {
        color: #edf5fc;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
      }

      .nav-links a:hover {
        color: var(--gold);
      }

      .hero {
        background:
          linear-gradient(
            120deg,
            rgba(10, 32, 54, 0.98),
            rgba(31, 96, 149, 0.93)
          );
        color: var(--white);
      }

      .hero-inner {
        width: min(1180px, calc(100% - 40px));
        min-height: 520px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.3fr 0.7fr;
        align-items: center;
        gap: 70px;
        padding: 80px 0;
      }

      .eyebrow {
        margin: 0 0 14px;
        color: var(--gold);
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 760px;
        margin: 0;
        font-size: clamp(2.7rem, 7vw, 5.4rem);
        line-height: 0.98;
        letter-spacing: -0.05em;
      }

      .hero-description {
        max-width: 690px;
        margin: 28px 0 0;
        color: #e5eef6;
        font-size: clamp(1.05rem, 2vw, 1.3rem);
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 34px;
      }

      .button {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 50px;
        padding: 12px 22px;
        border: 2px solid transparent;
        border-radius: 7px;
        text-decoration: none;
        font-weight: 800;
        transition:
          transform 0.15s ease,
          background 0.15s ease;
      }

      .button:hover {
        transform: translateY(-2px);
      }

      .button-primary {
        background: var(--gold);
        color: var(--navy-dark);
      }

      .button-secondary {
        border-color: rgba(255, 255, 255, 0.65);
        color: var(--white);
      }

      .hero-panel {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-radius: 18px;
        padding: 30px;
        backdrop-filter: blur(8px);
      }

      .hero-panel h2 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 1.3rem;
      }

      .hero-panel p {
        margin: 0 0 22px;
        color: #e4edf5;
      }

      .panel-link {
        display: block;
        margin-top: 12px;
        padding: 14px 16px;
        background: rgba(255, 255, 255, 0.11);
        border-radius: 7px;
        color: var(--white);
        text-decoration: none;
        font-weight: 700;
      }

      .panel-link:hover {
        background: rgba(255, 255, 255, 0.19);
      }

      .section {
        padding: 82px 0;
      }

      .section-inner {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
      }

      .section-header {
        max-width: 720px;
        margin-bottom: 38px;
      }

      .section-header h2 {
        margin: 0;
        color: var(--navy-dark);
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.1;
        letter-spacing: -0.035em;
      }

      .section-header p {
        margin: 14px 0 0;
        color: var(--muted);
        font-size: 1.05rem;
      }

      .course-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 26px;
      }

      .course-card {
        position: relative;
        overflow: hidden;
        min-height: 290px;
        padding: 36px;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 12px 35px rgba(17, 47, 78, 0.08);
      }

      .course-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 7px;
        height: 100%;
        background: var(--gold);
      }

      .course-number {
        color: var(--blue);
        font-size: 0.85rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .course-card h3 {
        margin: 14px 0 12px;
        color: var(--navy-dark);
        font-size: 1.8rem;
        line-height: 1.15;
      }

      .course-card p {
        max-width: 520px;
        margin: 0 0 26px;
        color: var(--muted);
      }

      .text-link {
        color: var(--blue);
        font-weight: 800;
        text-decoration: none;
      }

      .text-link:hover {
        text-decoration: underline;
      }

      .support-section {
        background: var(--white);
      }

      .support-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
      }

      .support-card {
        padding: 28px;
        border: 1px solid var(--border);
        border-radius: 12px;
      }

      .support-card h3 {
        margin: 0 0 8px;
        color: var(--navy-dark);
      }

      .support-card p {
        margin: 0 0 18px;
        color: var(--muted);
      }

      .site-footer {
        padding: 34px 0;
        background: var(--navy-dark);
        color: #c9d7e4;
      }

      .footer-inner {
        width: min(1180px, calc(100% - 40px));
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        gap: 24px;
      }

      .footer-inner p {
        margin: 0;
      }

      @media (max-width: 850px) {
        .nav-container {
          padding: 18px 0;
          align-items: flex-start;
        }

        .nav-links {
          display: none;
        }

        .hero-inner {
          grid-template-columns: 1fr;
          min-height: auto;
          gap: 45px;
          padding: 65px 0;
        }

        .course-grid,
        .support-grid {
          grid-template-columns: 1fr;
        }

        .course-card {
          min-height: auto;
        }

        .footer-inner {
          flex-direction: column;
        }
      }

      @media (max-width: 520px) {
        .nav-container,
        .hero-inner,
        .section-inner,
        .footer-inner {
          width: min(100% - 28px, 1180px);
        }

        .hero-actions {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .section {
          padding: 62px 0;
        }

        .course-card,
        .hero-panel {
          padding: 26px;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <nav class="nav-container" aria-label="Main navigation">
        <a class="brand" href="/">DAN KELLY | ACCOUNTING</a>

        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/financial-accounting">Financial Accounting</a>
          <a href="/managerial-accounting">Managerial Accounting</a>
          <a href="/resources">Resources</a>
          <a href="/office-hours">Office Hours</a>
          <a href="#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <div>
            <p class="eyebrow">Accounting Learning Hub</p>

            <h1>Accounting explained clearly.</h1>

            <p class="hero-description">
              Videos, examples, and course resources designed to help students
              understand Financial and Managerial Accounting.
            </p>

            <div class="hero-actions">
              <a class="button button-primary" href="/financial-accounting">
                Financial Accounting
              </a>

              <a class="button button-secondary" href="/managerial-accounting">
                Managerial Accounting
              </a>
            </div>
          </div>

          <aside class="hero-panel">
            <h2>Student Support</h2>

            <p>
              Looking for help outside Canvas? Start with the links below.
            </p>

            <a class="panel-link" href="/videos">Watch course videos →</a>
            <a class="panel-link" href="/resources">View student resources →</a>
            <a class="panel-link" href="/office-hours">Check office hours →</a>
          </aside>
        </div>
      </section>

      <section class="section">
        <div class="section-inner">
          <div class="section-header">
            <p class="eyebrow">Courses</p>
            <h2>Choose your course</h2>
            <p>
              Each course page will organize videos and supporting materials by
              chapter so students can quickly find the topic they need.
            </p>
          </div>

          <div class="course-grid">
            <article class="course-card">
              <span class="course-number">Course One</span>
              <h3>Financial Accounting</h3>

              <p>
                Resources covering the accounting cycle, financial statements,
                inventory, receivables, long-term assets, liabilities, equity,
                and cash flows.
              </p>

              <a class="text-link" href="/financial-accounting">
                Explore Financial Accounting →
              </a>
            </article>

            <article class="course-card">
              <span class="course-number">Course Two</span>
              <h3>Managerial Accounting</h3>

              <p>
                Resources covering cost behavior, job and process costing,
                cost-volume-profit analysis, budgeting, variance analysis, and
                decision making.
              </p>

              <a class="text-link" href="/managerial-accounting">
                Explore Managerial Accounting →
              </a>
            </article>
          </div>
        </div>
      </section>

      <section class="section support-section" id="contact">
        <div class="section-inner">
          <div class="section-header">
            <p class="eyebrow">Contact</p>
            <h2>Contact Dan Kelly</h2>
            <p>
              Questions about a course or worked problem? Reach out by email,
              visit my office, or join my personal Zoom room.
            </p>
          </div>

          <div class="support-grid">
            <article class="support-card">
              <h3>Email</h3>
              <p><a class="text-link" href="mailto:daniel.kelly@icc.edu">daniel.kelly@icc.edu</a></p>
            </article>

            <article class="support-card">
              <h3>Office</h3>
              <p><strong>Room 333E</strong><br />ICC East Peoria Campus</p>
            </article>

            <article class="support-card">
              <h3>Zoom</h3>
              <p><a class="text-link" href="https://us02web.zoom.us/my/dkellyicc" target="_blank" rel="noopener noreferrer">Open my Zoom room →</a></p>
            </article>
          </div>

          <article class="support-card" style="margin-top: 26px;">
            <h3>Directions to My Office on the East Peoria Campus</h3>
            <p>
              Walk into the double doors to the left of the building closest to
              you when you are in the visitor lot (around the corner and labeled
              door #9). Head to the open staircase—or take the elevator—and go up
              one floor to the café. Go past the art gallery into the academic
              hallway and turn right. About five doors later, the hallway takes a
              hard turn to the left; Room 333E is immediately on the left.
            </p>
          </article>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>© {currentYear} Dan Kelly</p>
        <p>Accounting Learning Hub</p>
      </div>
    </footer>
  </body>
</html>