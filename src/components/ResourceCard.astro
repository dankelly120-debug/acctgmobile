---
interface Props { title: string; url: string; type: 'video' | 'file' | 'tool'; }
const { title, url, type } = Astro.props;
const labels = { video: 'Watch video', file: 'Open file', tool: 'Open tool' };
const icons = { video: '▶', file: '📄', tool: '🧮' };
---
<a class:list={["resource", `resource--${type}`]} href={url} target="_blank" rel="noopener noreferrer">
  <span class="icon" aria-hidden="true">{icons[type]}</span>
  <span class="copy"><strong>{title}</strong><small>{labels[type]}</small></span>
  <span class="arrow" aria-hidden="true">↗</span>
</a>
<style>
.resource{display:grid;grid-template-columns:auto 1fr auto;gap:.8rem;align-items:center;padding:.9rem 1rem;border:1px solid var(--line);border-radius:12px;text-decoration:none;color:var(--ink);background:#fff;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease}.resource:hover{transform:translateY(-1px);box-shadow:0 7px 18px rgba(18,55,91,.09);border-color:#b8c9da}.icon{display:grid;place-items:center;width:2rem;height:2rem;border-radius:9px;background:#eef4f9}.resource--video .icon{background:#fff4d8}.copy{min-width:0}.copy strong{display:block;font-size:.98rem;line-height:1.3}.copy small{display:block;color:var(--muted);margin-top:.18rem}.arrow{color:var(--navy);font-weight:800}
</style>
