---
interface Link { title: string; url: string; type: 'video' | 'file' | 'tool'; role?: 'problem' | 'solution' | 'walkthrough' | 'resource'; label?: string; }
interface Props {
  id: string;
  kind: 'concept' | 'practice' | 'excel';
  title: string;
  links: readonly Link[];
  practiceNumber?: number;
}
const { id, kind, title, links, practiceNumber } = Astro.props;
const actionOrder: Record<string, number> = { walkthrough: 1, solution: 2, problem: 3, resource: 4 };
const orderedLinks = [...links].sort((a, b) => (actionOrder[a.role ?? 'resource'] ?? 4) - (actionOrder[b.role ?? 'resource'] ?? 4));
const heading = kind === 'practice' ? `Practice ${practiceNumber}` : kind === 'excel' ? 'Excel demonstration' : 'Concept lesson';
const description = kind === 'practice'
  ? 'Download the problem, try it on your own, then use the walkthrough and solution to check your work.'
  : kind === 'excel'
    ? 'Watch this demonstration to see how Excel can be used for the accounting task.'
    : 'Watch this lesson before moving to the related practice problems.';
const buttonCopy = (link: Link) => {
  if (kind === 'excel' && link.type === 'video') return 'Watch demonstration';
  if (link.role === 'problem') return 'Download problem';
  if (link.role === 'solution') return 'Check solution';
  if (link.role === 'walkthrough') return link.label ? `Watch ${link.label}` : 'Watch walkthrough';
  if (link.type === 'video') return 'Watch lesson';
  if (link.type === 'tool') return 'Open calculator';
  return 'Open resource';
};
const icon = (link: Link) => link.role === 'solution' ? '✓' : link.type === 'video' ? '▶' : link.type === 'tool' ? '⌨' : '↓';
---
<article class:list={['lesson-card', `lesson-card--${kind}`]}>
  <div class="lesson-topline">
    <span class="lesson-kind">{kind === 'practice' ? '✏️' : kind === 'excel' ? '📊' : '🎥'} {heading}</span>
    <label class="complete-label">
      <input class="progress-check" type="checkbox" data-progress-id={id} />
      <span>Completed</span>
    </label>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="actions">
    {orderedLinks.map((link) => (
      <a class:list={['action', link.role && `action--${link.role}`]} href={link.url} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">{icon(link)}</span>
        <span>{buttonCopy(link)}</span>
      </a>
    ))}
  </div>
</article>

<style>
.lesson-card{border:1px solid var(--line);border-radius:16px;padding:1rem;background:#fff;box-shadow:0 4px 12px rgba(18,55,91,.05)}
.lesson-card--concept{border-left:5px solid #3d78a8}.lesson-card--practice{border-left:5px solid #40875c;background:#fbfefc}.lesson-card--excel{border-left:5px solid #9a6a1a;background:#fffdf7}
.lesson-topline{display:flex;justify-content:space-between;gap:1rem;align-items:center}.lesson-kind{font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.lesson-card h3{margin:.35rem 0 .35rem;color:var(--navy);font-size:1.08rem;line-height:1.3}.lesson-card p{margin:0 0 .85rem;color:var(--muted);font-size:.9rem}
.complete-label{display:flex;align-items:center;gap:.35rem;color:var(--muted);font-size:.78rem;white-space:nowrap}.complete-label input{width:1rem;height:1rem;accent-color:#40875c}
.actions{display:flex;flex-wrap:wrap;gap:.55rem}.action{display:inline-flex;align-items:center;gap:.45rem;padding:.62rem .78rem;border-radius:10px;border:1px solid #c9d6e2;background:#f4f8fb;color:var(--navy);font-weight:750;font-size:.87rem;text-decoration:none}.action:hover{background:#eaf2f8}.action--problem{background:#fff8e5;border-color:#ead08a}.action--walkthrough{background:#edf5fb}.action--solution{background:#edf8f0;border-color:#b9d8c2;color:#245f38}
@media(max-width:560px){.lesson-topline{align-items:flex-start}.actions{display:flex;flex-direction:column-reverse}.action{justify-content:center;width:100%}}
</style>
