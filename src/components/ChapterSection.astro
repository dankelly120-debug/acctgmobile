---
import LessonCard from './LessonCard.astro';
interface Item { title: string; url: string; type: 'video' | 'file' | 'tool'; label?: string; }
interface Props { number: string; title: string; items: readonly Item[]; }
interface Link extends Item { role?: 'problem' | 'solution' | 'walkthrough' | 'resource'; }
interface Lesson { title: string; links: Link[]; }
const { number, title, items } = Astro.props;
const anchor = `chapter-${number.replace(/[^a-zA-Z0-9]+/g, '-')}`;
const concepts: Lesson[] = [];
const practices: Lesson[] = [];
const extras: Link[] = [];

const isPracticeVideo = (name: string) => /problem|exercise|example|by hand|in excel|excel focus|homework|starcups|hoodies|sales mix|cost flow|amortization|series/i.test(name);
const cleanTitle = (name: string) => name
  .replace(/^problem:\s*/i, '')
  .replace(/^problem\s*/i, '')
  .replace(/^\(?pdf\)?\s*/i, '')
  .replace(/\s*\(pdf.*$/i, '')
  .trim();
const fileRole = (name: string): Link['role'] => /solution|answer/i.test(name) ? 'solution' : /problem|data|transactions used/i.test(name) ? 'problem' : 'resource';

for (const item of items) {
  if (item.type === 'video') {
    if (/^video\s*\d+/i.test(item.title) && practices.length) {
      practices[practices.length - 1].links.push({ ...item, role: 'walkthrough' });
    } else if (isPracticeVideo(item.title)) {
      practices.push({ title: cleanTitle(item.title), links: [{ ...item, role: 'walkthrough' }] });
    } else {
      concepts.push({ title: cleanTitle(item.title), links: [{ ...item }] });
    }
  } else {
    const link: Link = { ...item, role: fileRole(item.title) };
    if (practices.length) practices[practices.length - 1].links.push(link);
    else extras.push(link);
  }
}
---
<section class="chapter" id={anchor}>
  <div class="chapter-heading">
    <div><span>Chapter {number}</span><h2>{title}</h2></div>
    <a href="#top">Back to top ↑</a>
  </div>

  {concepts.length > 0 && (
    <div class="lesson-group">
      <h3 class="group-title">1. Learn the concepts</h3>
      <div class="card-grid">
        {concepts.map((lesson, index) => <LessonCard id={`chapter-${number}-concept-${index + 1}`} kind="concept" title={lesson.title} links={lesson.links} />)}
      </div>
    </div>
  )}

  {practices.length > 0 && (
    <div class="lesson-group">
      <h3 class="group-title">2. Practice and check your work</h3>
      <div class="card-grid">
        {practices.map((lesson, index) => <LessonCard id={`chapter-${number}-practice-${index + 1}`} kind="practice" practiceNumber={index + 1} title={lesson.title} links={lesson.links} />)}
      </div>
    </div>
  )}

  {extras.length > 0 && (
    <div class="extras">
      <h3>Chapter resources</h3>
      <div class="extra-links">
        {extras.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">📄 {cleanTitle(link.title)}</a>)}
      </div>
    </div>
  )}
</section>

<style>
.chapter{background:#fff;border:1px solid var(--line);border-radius:20px;padding:clamp(1.1rem,3vw,1.8rem);margin:1.3rem 0;box-shadow:0 6px 18px rgba(18,55,91,.06);scroll-margin-top:1rem}.chapter-heading{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;border-bottom:1px solid var(--line);padding-bottom:.9rem}.chapter-heading span{color:var(--muted);font-weight:800;font-size:.8rem;text-transform:uppercase;letter-spacing:.08em}.chapter-heading h2{color:var(--navy);margin:.15rem 0 0;font-size:clamp(1.35rem,3vw,1.7rem)}.chapter-heading>a{color:var(--muted);font-size:.82rem;text-decoration:none;white-space:nowrap}.lesson-group{margin-top:1.15rem}.group-title{margin:0 0 .7rem;font-size:1rem;color:#273747}.card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.extras{margin-top:1rem;padding-top:1rem;border-top:1px dashed var(--line)}.extras h3{font-size:.95rem;margin:0 0 .55rem}.extra-links{display:flex;flex-wrap:wrap;gap:.55rem}.extra-links a{padding:.55rem .7rem;border-radius:9px;background:#f4f7fa;color:var(--navy);font-weight:700;font-size:.85rem;text-decoration:none}@media(max-width:780px){.card-grid{grid-template-columns:1fr}}
</style>
